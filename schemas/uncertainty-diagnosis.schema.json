{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/historical-geo/uncertainty-diagnosis.schema.json",
  "title": "Historical geography uncertainty diagnosis v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "baseline_scenario", "slices"],
  "properties": {
    "contract_version": {"const": "historical_geo.uncertainty_diagnosis.v0.2"},
    "case_id": {"type": "string", "minLength": 1},
    "baseline_scenario": {"type": "string", "minLength": 1},
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice", "classification", "affected_grid_cells", "changed_scenarios", "changed_decision_ids"],
        "properties": {
          "slice": {"type": ["integer", "string"]},
          "classification": {"enum": ["evidence_gap", "model_sensitivity", "mixed"]},
          "affected_grid_cells": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence", "model", "total"],
            "properties": {
              "evidence": {"type": "integer", "minimum": 0},
              "model": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 1}
            }
          },
          "changed_scenarios": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence", "model"],
            "properties": {
              "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "model": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "changed_decision_ids": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence", "model", "all"],
            "properties": {
              "evidence": {"$ref": "#/$defs/identifierList"},
              "model": {"$ref": "#/$defs/identifierList"},
              "all": {"$ref": "#/$defs/identifierList"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "identifierList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
  }
}
