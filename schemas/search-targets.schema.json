{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/historical-geo/search-targets.schema.json",
  "title": "Historical geography evidence search targets v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "targets"],
  "properties": {
    "contract_version": {"const": "historical_geo.search_targets.v0.2"},
    "case_id": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "evidence_gap_ids", "claim_ids", "decision_ids", "question", "preferred_source_types", "success_criteria", "stop_condition", "priority_basis", "status"],
        "properties": {
          "target_id": {"$ref": "#/$defs/identifier"},
          "evidence_gap_ids": {"$ref": "#/$defs/identifierList", "minItems": 1},
          "claim_ids": {"$ref": "#/$defs/identifierList"},
          "decision_ids": {"$ref": "#/$defs/identifierList"},
          "question": {"type": "string", "minLength": 1},
          "preferred_source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "success_criteria": {"type": "string", "minLength": 1},
          "stop_condition": {"type": "string", "minLength": 1},
          "priority_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["affected_grid_cells", "related_decision_count", "related_decision_ids", "slices"],
            "properties": {
              "affected_grid_cells": {"type": "integer", "minimum": 1},
              "related_decision_count": {"type": "integer", "minimum": 1},
              "related_decision_ids": {"$ref": "#/$defs/identifierList", "minItems": 1},
              "slices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["integer", "string"]}}
            }
          },
          "status": {"enum": ["open", "closed", "deferred"]}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "identifierList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
  }
}
